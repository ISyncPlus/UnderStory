# ─────────────────────────────────────────────────────────────────────────────
# Understory — connection details
#
# Copy this file to `.env.local` and fill in the values from the CognoDB Cloud
# console. `.env.local` is gitignored; never commit real credentials.
#
# Full walkthrough: docs/SETUP-COGNODB.md
# ─────────────────────────────────────────────────────────────────────────────

# The Bolt URI for your instance. CognoDB Cloud gives you a `bolt+s://` URI
# (TLS is implied by the scheme — no extra driver configuration is needed).
#   e.g. bolt+s://a1b2c3d4.databases.cognodb.cloud
NEO4J_URI=bolt+s://REPLACE_ME.databases.cognodb.cloud

# CognoDB Cloud provisions this user by default.
NEO4J_USERNAME=cognodb

# Shown exactly once when the instance is created. Copy it immediately.
NEO4J_PASSWORD=REPLACE_ME

# Optional. CognoDB free (c0) instances use the default database; leave blank
# unless your console tells you otherwise.
NEO4J_DATABASE=

# Optional. Public label shown in the interface so a reviewer can tell which
# instance they are looking at. Purely cosmetic.
NEXT_PUBLIC_INSTANCE_LABEL=CognoDB c0 · free tier
