{
  "name": "understory",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "@hugeicons/core-free-icons": "^4.3.0",
    "@hugeicons/react": "^1.1.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lucide-react": "^1.33.0",
    "neo4j-driver": "^5.28.1",
    "next": "^16.3.1",
    "next-themes": "^0.4.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.18.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@neo4j-cypher/language-support": "^2.0.0-next.6",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "css-select": "^7.0.0",
    "css-tree": "^3.2.1",
    "domutils": "^4.0.2",
    "dotenv": "^16.4.7",
    "htmlparser2": "^12.0.0",
    "playwright": "^1.56.0",
    "postcss": "^8.5.26",
    "puppeteer": "^25.8.0",
    "puppeteer-core": "^25.8.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2"
  },
  "description": "Trace the shortest dependency path from an application you own to code you did not write — and the one change that cuts it. Backed by a graph database over openCypher/Bolt.",
  "scripts": {
    "dev": "next dev",
    "dev:fixtures": "UNDERSTORY_FIXTURES=1 next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "cypher:check": "tsx scripts/validate-cypher.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:reset": "tsx scripts/seed.ts --reset",
    "db:check": "tsx scripts/check-db.ts",
    "data:verify": "tsx scripts/seed.ts --dry-run",
    "shots": "UNDERSTORY_FIXTURES=1 tsx scripts/screenshots.ts",
    "verify": "npm run typecheck && npm run cypher:check && npm run data:verify",
    "docs:queries": "tsx scripts/document-queries.ts"
  },
  "engines": {
    "node": ">=20.9"
  },
  "author": "Ebube Ezediimbu <https://github.com/ISyncPlus>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ISyncPlus/understory.git"
  }
}
